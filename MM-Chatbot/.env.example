# ==========================================
# Multimodal AI Personal Assistant Configuration
# ==========================================

# 1. Database Configuration
# Local SQLite default (no setup needed): sqlite+aiosqlite:///./data.db
# PostgreSQL with pgvector (optional): postgresql+asyncpg://postgres:postgres@localhost:5432/mm_assistant
DATABASE_URL=sqlite+aiosqlite:///./data.db

# ==========================================
# 2. Four AI Model Providers
# ==========================================

# 1. OpenAI (Supports Text + Vision)
OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# 2. Google Gemini (Supports Text + Vision)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Hugging Face (Serverless Inference)
HF_TOKEN=PASTE_YOUR_HUGGINGFACE_TOKEN_HERE
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# 4. Grok by xAI / Groq (Supports Text + Vision)
XAI_API_KEY=PASTE_YOUR_GROK_OR_GROQ_KEY_HERE
XAI_MODEL=qwen/qwen3.8-27b

# Intelligent Provider Fallback Priority (comma-separated order)
PROVIDER_PRIORITY=xai,gemini,huggingface,openai

# ==========================================
# 3. Embeddings & RAG Configuration
# ==========================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=3072
RAG_SIMILARITY_THRESHOLD=0.70
RAG_TOP_K=4

# ==========================================
# 4. Web Search Configuration
# ==========================================
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=PASTE_YOUR_TAVILY_KEY_HERE

# ==========================================
# 5. Speech Services (STT & TTS)
# ==========================================
# Text-to-Speech: "edge-tts" is 100% free with natural neural voices (no key required)
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-JennyNeural
STT_PROVIDER=gemini

# ==========================================
# 6. Server & Security Settings
# ==========================================
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_PER_MINUTE=60
